# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Proyek: KasirToko POS - React Native Offline-First
# ==============================================================================
# Petunjuk Penggunaan:
# 1. Salin berkas ini menjadi '.env' di root folder:
#    cp .env.example .env   (Linux / macOS / Git Bash)
#    copy .env.example .env (Windows CMD / PowerShell)
# 2. Isi nilai variabel di bawah ini dengan kredensial Supabase proyek Anda.
# 3. PERINGATAN KEAMANAN:
#    Hanya gunakan ANON / PUBLIC KEY pada aplikasi client (React Native).
#    JANGAN PERNAH memasukkan Supabase Service Role Key ke dalam berkas ini!
# ==============================================================================

# URL Proyek Supabase (Dashboard -> Settings -> API -> Project URL)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon Key / Publishable Key Supabase (Dashboard -> Settings -> API -> Project API Keys)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Alias kunci publik untuk kompatibilitas ke belakang (opsional)
EXPO_PUBLIC_SUPABASE_KEY=your_supabase_anon_key_here
